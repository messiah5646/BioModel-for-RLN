# OS
.DS_Store
Thumbs.db

# Real trial data is small, public, and load-bearing -- keep it tracked.
!data/real/
!data/real/*.csv
experiments/kidney-compartments/data/

# Small result tables are load-bearing (resp_table.csv was lost once, round 94). Keep them tracked.
!experiments/lumen-bench/**/*.csv
!experiments/**/prospective/**
!experiments/**/results/*.csv
# keep Python caches out even inside re-included prospective/ dirs (round 144)
**/__pycache__/

# write-once re-run scratch (round 158)
.reruns/

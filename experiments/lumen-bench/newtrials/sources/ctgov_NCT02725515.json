{"protocolSection":{"identificationModule":{"nctId":"NCT02725515","orgStudyIdInfo":{"id":"XmAb5871-04"},"organization":{"fullName":"Xencor, Inc.","class":"INDUSTRY"},"briefTitle":"A Study of the Effect of XmAb®5871 in Patients With Systemic Lupus Erythematosus","officialTitle":"A Randomized, Double-Blinded, Placebo-Controlled Study of the Effect of XmAb®5871 on Systemic Lupus Erythematosus Disease Activity"},"statusModule":{"statusVerifiedDate":"2019-08","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2016-02-16","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2018-07-17","type":"ACTUAL"},"completionDateStruct":{"date":"2018-07-17","type":"ACTUAL"},"studyFirstSubmitDate":"2016-01-08","studyFirstSubmitQcDate":"2016-03-28","studyFirstPostDateStruct":{"date":"2016-04-01","type":"ESTIMATED"},"resultsFirstSubmitDate":"2019-06-06","resultsFirstSubmitQcDate":"2019-08-08","resultsFirstPostDateStruct":{"date":"2019-08-09","type":"ACTUAL"},"lastUpdateSubmitDate":"2019-08-08","lastUpdatePostDateStruct":{"date":"2019-08-20","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Xencor, Inc.","class":"INDUSTRY"},"collaborators":[{"name":"PPD Development, LP","class":"INDUSTRY"},{"name":"ICON plc","class":"INDUSTRY"}]},"oversightModule":{"oversightHasDmc":false},"descriptionModule":{"briefSummary":"The purpose of this study is to determine the ability of XmAb5871 to maintain Systemic Lupus Erythematosus (SLE) disease activity improvement achieved by a brief course of disease-suppressing steroid therapy"},"conditionsModule":{"conditions":["Systemic Lupus Erythematosus"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","interventionModelDescription":"Randomized (1:1, no stratification), Double-Blinded, Placebo-Controlled","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUA